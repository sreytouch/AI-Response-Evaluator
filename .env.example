# Copy this file to .env and replace the placeholder. Never commit .env.
OPENAI_API_KEY=your_api_key_here

# This model supports the Responses API and temperature sampling.
OPENAI_MODEL=gpt-4.1-mini

# Disable temperature for a model that does not support this parameter.
# Independent writing approaches still provide variation when disabled.
OPENAI_USE_TEMPERATURE=true
OPENAI_TEMPERATURE_A=0.4
OPENAI_TEMPERATURE_B=0.9
OPENAI_MAX_OUTPUT_TOKENS=1024

# Relative paths are resolved from the project folder, not the shell directory.
EVALUATOR_DB_PATH=data/evaluations.db
